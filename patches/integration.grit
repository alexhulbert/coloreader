engine marzano(0.1)
language js

pattern default_theme() {
    `immediateModify: false` => `immediateModify: false,
    paletteMode: true`
}

pattern default_settings() {
    or {
        `changeBrowserTheme: false` => `changeBrowserTheme: true`,
        `detectDarkTheme: true` => `detectDarkTheme: false`
    }
}

pattern theme_type() {
    `immediateModify: boolean` => `immediateModify: boolean;
    paletteMode?: boolean;
    paletteSourceBackground?: string`
}

pattern validate_palette() {
    `validateProperty(theme, 'immediateModify', isBoolean, DEFAULT_THEME)` =>
    `validateProperty(theme, 'immediateModify', isBoolean, DEFAULT_THEME);
    validateProperty(theme, 'paletteMode', isBoolean, DEFAULT_THEME)`
}

pattern color_import() {
    `import type {Theme} from '../../definitions';` =>
    `import type {Theme} from '../../definitions';
    import {paletteModifier, paletteShadow, withPaletteSource} from '../../coloreader/colors';

    const paletteBackground = paletteModifier((source, background) => modifyBgHSL(source, background), true);
    const paletteText = paletteModifier((source, _background, foreground) => modifyFgHSL(source, foreground));
    const paletteBorder = paletteModifier((source, background, foreground) => modifyBorderHSL(source, foreground, background));
    const lightPaletteTone = (source: HSLA, background: HSLA, foreground: HSLA) => modifyLightModeHSL(source, foreground, background);
    const paletteLight = paletteModifier(lightPaletteTone);
    const paletteLightSurface = paletteModifier(lightPaletteTone, true);`
}

pattern palette_color_cache_keys() {
    `extendThemeCacheKeys(themeCacheKeys)` =>
    `themeCacheKeys.push('paletteMode', 'paletteSourceBackground');
    extendThemeCacheKeys(themeCacheKeys)`
}

pattern palette_color_context() {
    `modifyHSL(hsl, pole!, anotherPole!)` =>
    `withPaletteSource(modifyHSL, hsl, pole!, anotherPole!, theme)`
}

pattern background_color() {
    `function _modifyBackgroundColor($rgb: RGBA, $theme: Theme) { $body }` =>
    `function _modifyBackgroundColor($rgb: RGBA, $theme: Theme) {
        if ($theme.paletteMode) {
            return modifyColorWithCache($rgb, $theme, $theme.mode === 1 ? paletteBackground : paletteLightSurface, getBgPole($theme), getFgPole($theme));
        }
        $body
    }`
}

pattern foreground_color() {
    `function _modifyForegroundColor($rgb: RGBA, $theme: Theme) { $body }` =>
    `function _modifyForegroundColor($rgb: RGBA, $theme: Theme) {
        if ($theme.paletteMode) {
            return modifyColorWithCache($rgb, $theme, $theme.mode === 1 ? paletteText : paletteLight, getBgPole($theme), getFgPole($theme));
        }
        $body
    }`
}

pattern border_color() {
    `function _modifyBorderColor($rgb: RGBA, $theme: Theme) { $body }` =>
    `function _modifyBorderColor($rgb: RGBA, $theme: Theme) {
        if ($theme.paletteMode) {
            return modifyColorWithCache($rgb, $theme, $theme.mode === 1 ? paletteBorder : paletteLight, getBgPole($theme), getFgPole($theme));
        }
        $body
    }`
}

pattern shadow_color() {
    `function modifyShadowColor($rgb: RGBA, $theme: Theme): string { $body }` =>
    `function modifyShadowColor($rgb: RGBA, $theme: Theme): string {
        if ($theme.paletteMode) {
            return modifyColorWithCache($rgb, $theme, paletteShadow, getBgPole($theme), getFgPole($theme));
        }
        $body
    }`
}

pattern image_import() {
    `import type {Theme} from '../../definitions';` =>
    `import type {Theme} from '../../definitions';
    import {paletteImageValue} from '../../coloreader/images';
    import {paletteSourceColor} from '../../coloreader/source';
    import {isLinkColor, linkColor} from '../../coloreader/links';`
}

// Map generated colors from a white background to the page background
pattern palette_default_colors() {
    or {
        `modifyBackgroundColor($color, $theme)` as $call where {
            $call <: within function_declaration(name=$name),
            $name <: or {`getModifiedUserAgentStyle`, `getSelectionColor`, `getModifiedScrollbarStyle`, `defaultFallbackFactory`},
            $call => `modifyBackgroundColor(paletteSourceColor($color, $theme), $theme)`
        },
        `modifyForegroundColor($color, $theme)` as $call where {
            $call <: within function_declaration(name=$name),
            $name <: or {`getModifiedUserAgentStyle`, `getSelectionColor`, `getModifiedScrollbarStyle`, `defaultFallbackFactory`},
            $call => `modifyForegroundColor(paletteSourceColor($color, $theme), $theme)`
        },
        `modifyBorderColor($color, $theme)` as $call where {
            $call <: within function_declaration(name=$name),
            $name <: or {`getModifiedUserAgentStyle`, `getModifiedScrollbarStyle`, `defaultFallbackFactory`},
            $call => `modifyBorderColor(paletteSourceColor($color, $theme), $theme)`
        }
    }
}

pattern palette_source_import() {
    `import type {Theme, DynamicThemeFix} from '../../definitions';` =>
    `import type {Theme, DynamicThemeFix} from '../../definitions';
    import {readPaletteSource, watchPaletteSource, paletteSourceColor} from '../../coloreader/source';
    import {applySiteFixes} from '../../coloreader/site-fixes';
    import {linkScope} from '../../coloreader/links';`
}

pattern site_fixes_extension() {
    `selectRelevantFix(document.location.href, dynamicThemeFixes)` =>
    `applySiteFixes(document.location.href, selectRelevantFix(document.location.href, dynamicThemeFixes))`
}

pattern site_fixes_api() {
    or {
        `import {DEFAULT_THEME} from '../defaults';` =>
        `import {DEFAULT_THEME} from '../defaults';
        import {applySiteFixes} from '../coloreader/site-fixes';`,
        `createOrUpdateDynamicThemeInternal(theme, fixes, isIFrame)` =>
        `createOrUpdateDynamicThemeInternal(theme, applySiteFixes(document.location.href, fixes), isIFrame)`
    }
}

pattern palette_source_theme() {
    `theme = themeConfig` =>
    `document.dispatchEvent(new CustomEvent('coloreader:theme', {detail: JSON.stringify(themeConfig)}));
    theme = {...themeConfig, paletteSourceBackground: themeConfig.paletteMode ? readPaletteSource() : undefined}`
}

pattern palette_source_watch() {
    `function createThemeAndWatchForUpdates() { $body }` =>
    `let stopPaletteSourceWatch: (() => void) | null = null;
    function stopPaletteSource() {
        stopPaletteSourceWatch?.();
        stopPaletteSourceWatch = null;
    }

    function createThemeAndWatchForUpdates() {
        if (theme?.paletteMode && !stopPaletteSourceWatch) {
            stopPaletteSourceWatch = watchPaletteSource(() => {
                if (theme?.paletteMode && readPaletteSource() !== theme.paletteSourceBackground) {
                    createOrUpdateDynamicThemeInternal(theme, fixes, isIFrame!);
                }
            });
            if (!cleaners.includes(stopPaletteSource)) {
                cleaners.push(stopPaletteSource);
            }
        } else if (!theme?.paletteMode) {
            stopPaletteSource();
        }
        $body
    }`
}

pattern palette_source_stop() {
    `function stopWatchingForUpdates() { $body }` =>
    `function stopWatchingForUpdates() {
        stopPaletteSource();
        $body
    }`
}

// Destroy old adopted style managers before rebuilding the palette
pattern palette_adopted_rebuild() {
    `function createDynamicStyleOverrides() { $body }` =>
    `function createDynamicStyleOverrides() {
        if (theme!.paletteMode || prevTheme?.paletteMode) {
            adoptedStyleManagers.splice(0).forEach((manager) => manager.destroy());
        }
        $body
    }`
}

// Clear cached overrides when an adopted style manager is destroyed
pattern palette_adopted_cleanup() {
    `function destroy() { $body }` =>
    `function destroy() {
        iterateSourceSheets((sheet) => overridesBySource.delete(sheet));
        $body
    }`
}

pattern variable_rule_update() {
    statement_block($statements) where {
        $statements <: [..., `oldDecs = $next;` as $assignment, `rebuildVarRule($key);` as $call, ...],
        $assignment => `rebuildVarRule($key, oldDecs, $next);`,
        $call => `oldDecs = $next;`
    }
}

pattern variable_rule_properties() {
    `function rebuildVarRule(key: number) {
        const {rule, target, index} = varDeclarations.get(key)!;
        target.deleteRule(index);
        setRule(target, index, rule);
    }` =>
    `function rebuildVarRule(key: number, previous: ReadyDeclaration[], next: ReadyDeclaration[]) {
        const {target, index} = varDeclarations.get(key)!;
        const style = (target.cssRules[index] as CSSStyleRule).style;
        previous.forEach(({property}) => style.removeProperty(property));
        next.forEach(({property, value, important}) => {
            if (value) {
                style.setProperty(property, String(value), important ? 'important' : '');
            }
        });
    }`
}

pattern palette_neutral_background() {
    `modifyBackgroundColor(parseColorWithCache('#ffffff')!, theme!)` =>
    `modifyBackgroundColor(paletteSourceColor(parseColorWithCache('#ffffff')!, theme!), theme!)`
}

pattern palette_neutral_text() {
    `modifyForegroundColor(parseColorWithCache('#000000')!, theme!)` =>
    `modifyForegroundColor(paletteSourceColor(parseColorWithCache('#000000')!, theme!), theme!)`
}

pattern palette_template_colors() {
    or {
        `modifyBackgroundColor(color, theme!)` as $call where {
            $call <: within function_declaration(name=`replaceCSSTemplates`),
            $call => `modifyBackgroundColor(paletteSourceColor(color, theme!), theme!)`
        },
        `modifyForegroundColor(color, theme!)` as $call where {
            $call <: within function_declaration(name=`replaceCSSTemplates`),
            $call => `modifyForegroundColor(paletteSourceColor(color, theme!), theme!)`
        }
    }
}

pattern native_controls() {
    `(__CHROMIUM_MV3__ || isCSSColorSchemePropSupported) && theme.mode === 1` =>
    `__CHROMIUM_MV3__ || isCSSColorSchemePropSupported`
}

pattern native_control_scheme() {
    js"`    color-scheme: dark !important;`" =>
    js"`    color-scheme: ${theme.mode === 1 ? 'dark' : 'light'} !important;`"
}

pattern link_color() {
    js"lines.push(`    color: ${modifyForegroundColor(paletteSourceColor({r: 0, g: 64, b: 255}, theme), theme)};`);" =>
    js"lines.push(`    color: ${linkColor(modifyForegroundColor(paletteSourceColor({r: 0, g: 64, b: 255}, theme), theme))};`);"
}

pattern link_scope() {
    `inlineStyle.textContent = getInlineOverrideStyle()` => `inlineStyle.textContent = getInlineOverrideStyle() + linkScope(theme!)`
}

pattern link_declaration() {
    `return {property, value: modifier, important: getPriority(rule.style, property), sourceValue: value}` =>
    `if ((property === 'color' || property === '-webkit-text-fill-color') && typeof modifier === 'function' && isLinkColor(value)) {
        const textModifier = modifier as CSSValueModifier;
        modifier = (theme: Theme) => {
            const color = textModifier(theme);
            return theme.paletteMode && typeof color === 'string' ? linkColor(color) : color;
        };
    }
    return {property, value: modifier, important: getPriority(rule.style, property), sourceValue: value}`
}

// Set the background color to the exact specified background
pattern canvas_color() {
    `if (!isIFrame) { $body }` as $block where {
        $block <: within function_declaration(name=`getModifiedUserAgentStyle`),
        $block => js"if (!isIFrame) {
            if (theme.paletteMode) {
                const background = modifyBackgroundColor({r: 255, g: 255, b: 255}, theme);
                const foreground = modifyForegroundColor({r: 0, g: 0, b: 0}, theme);
                lines.push(`html:root, html:root body { background-color: ${background} !important; color: ${foreground} !important; }`);
            } else {
                $body
            }
        }"
    }
}

pattern css_color_scheme() {
    `theme.mode === 0 ? 'dark light' : 'dark'` => `theme.mode === 0 ? 'light' : 'dark'`
}

pattern scrollbar_thumb() {
    `modifyBackgroundColor({r: 176, g: 176, b: 176}, theme)` => `modifyBorderColor({r: 128, g: 128, b: 128}, theme)`
}

pattern background_images() {
    `const getBgImageValue = (imageDetails: ImageDetails, theme: Theme) => { $body }` =>
    `const getBgImageValue = (imageDetails: ImageDetails, theme: Theme) => {
        if (theme.paletteMode) {
            return paletteImageValue(imageDetails, theme, canFilterImage(imageDetails.src));
        }
        $body
    }`
}

pattern inline_svg() {
    `isSVGElement && theme.mode === 1 && svg` => `isSVGElement && theme.mode === 1 && !theme.paletteMode && svg`
}

pattern inline_cache_keys() {
    `const themeProps: Array<keyof Theme> = [$keys]` =>
    `const themeProps: Array<keyof Theme> = [$keys, 'paletteMode', 'paletteSourceBackground', 'darkSchemeBackgroundColor', 'darkSchemeTextColor', 'lightSchemeBackgroundColor', 'lightSchemeTextColor']`
}

pattern inline_cache_invalidation() {
    `themeKey = ''` as $assignment where {
        $assignment <: within function_declaration(name=`getThemeKey`),
        $assignment => `inlineStringValueCache.clear();
        themeKey = ''`
    }
}

pattern palette_cache_without_fixes() {
    `prevTheme && prevFixes` => `prevTheme`
}

// Color variables alone don't update raw RGB colors, shadows or images
pattern palette_render_updates() {
    `if (onlyColorsChanged) { $body }` =>
    `if (onlyColorsChanged && !theme.paletteMode) { $body }`
}

pattern pdf_overlay_target() {
    `isEdge ? tryInvertEdgePDF() : tryInvertChromePDF()` =>
    `theme!.mode === 1 && (isEdge ? tryInvertEdgePDF() : tryInvertChromePDF())`
}

pattern integration_import() {
    `import UserStorage from './user-storage';` =>
    `import UserStorage from './user-storage';
    import {startPaletteIntegration, browserTheme} from '../coloreader/integration';`
}

pattern start_palette() {
    `Extension.updateAutoState()` as $call where {
        $call <: within method_definition(name=`start`),
        $call => `startPaletteIntegration(UserStorage, Extension.setTheme, Extension.changeSettings);
        Extension.updateAutoState()`
    }
}

pattern browser_colors() {
    `setWindowTheme(UserStorage.settings.theme)` =>
    `setWindowTheme(browserTheme(UserStorage.settings.theme, Extension.autoState))`
}

pattern browser_light_target() {
    `Extension.isExtensionSwitchedOn() && Extension.autoState !== 'scheme-light'` => `Extension.isExtensionSwitchedOn()`
}

pattern browser_palette_import() {
    `import type {Theme} from '../definitions';` =>
    `import type {Theme} from '../definitions';
    import {browserPaletteColors} from '../coloreader/integration';`
}

pattern browser_palette_colors() {
    `browser.theme.update({colors})` =>
    `browser.theme.update({colors: browserPaletteColors(theme, colors), ...(theme.paletteMode && {properties: {color_scheme: theme.mode === 1 ? 'dark' : 'light', content_color_scheme: theme.mode === 1 ? 'dark' : 'light'}})})`
}

pattern pdf_target() {
    `UserStorage.settings.enableForPDF` as $flag where {
        $flag <: within call_expression(function=`getDynamicThemeFixesFor`),
        $flag => `UserStorage.settings.enableForPDF && theme.mode === 1`
    }
}

pattern stub_imports() {
    `import $what from $path` where {
        $path <: r"'([a-z].*)'"($module),
        $path => `'../../$module'`
    }
}
